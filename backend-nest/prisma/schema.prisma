generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  telefone  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([telefone], map: "idx_clientes_telefone")
  @@map("clientes")
}

model Funcionario {
  id        Int    @id @default(autoincrement())
  nome      String @unique @db.VarChar(120)
  senhaHash String @map("senha_hash") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("funcionarios")
}

model Copo {
  id         Int     @id @default(autoincrement())
  tamanho    String  @unique @db.VarChar(20)
  preco      Decimal @db.Decimal(10, 2)
  disponivel Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("copos")
}

model Adicional {
  id             Int     @id @default(autoincrement())
  nome           String  @unique @db.VarChar(120)
  preco          Decimal @default(0) @db.Decimal(10, 2)
  acompanhamento Boolean @default(true)
  disponivel     Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("adicionais")
}
